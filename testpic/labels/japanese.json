{
  "format_version": 1,
  "annotation_version": 1,
  "annotation_method": "model_visual_transcription_from_supplied_images",
  "annotation_scope": "six_target_regions_visible_japanese",
  "source_manifest": "../manifest.csv",
  "chinese_annotation_status": "pending",
  "text_conventions": {
    "whitespace": "每行去除首尾排版空白；相邻空白格合并为一个 ASCII 空格。保留可见行及字段的顺序。",
    "characters": "数字采用 ASCII；可见的日文、大小假名、清浊点、标点、长音和正文中的“円”保留，不按语义纠错或补字。",
    "ellipsis": "画面中两个三点字形记为“……”，不改写为句号。",
    "level_marker": "PC 宝可梦列表中显示为 :L 形状的等级字形记为 <Lv>，按一个字形 token 统计；数字仍须完全正确。",
    "non_text": "选择指针、下翻箭头和边框不计入文本；选择位置另存为从 0 起的 selected_row 或 selected_item。",
    "footer": "footer_lines 是目标列表附属退出框的可见文字，同样纳入逐字比较。",
    "empty": "空框和无目标样本保留记录；expected_no_target_text=true 时不得产生目标文字。",
    "semantic_type": "type 是档案用途说明；共享文字网格的语义用途未定不阻止 rawOcr，也不作为文字正确与否的替代条件。"
  },
  "acceptance_target": {
    "images": 108,
    "raw_ocr_character_accuracy": 1,
    "raw_ocr_cer": 0,
    "image_exact_match_accuracy": 1,
    "required": "所有目标区域和 footer_lines 均完整一致；漏区域、漏字、多字、错字、未知字符和负样本误输出均不通过。没有产品运行结果时不得记为达标。",
    "chinese": "中文标注与中文通过门槛待定；本阶段日文达标不代表最终中文验收通过。"
  },
